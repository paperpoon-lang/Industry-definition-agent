# 行业定义 Agent v4 — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ============================================================
# LLM API 配置（硅基流动 SiliconFlow）
# ============================================================

# API 密钥
LLM_API_KEY=sk-your-api-key-here

# API Base URL
LLM_BASE_URL=https://api.siliconflow.cn/v1

# 模型 ID
LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro

# ============================================================
# Tavily 搜索 API 配置
# ============================================================

# Tavily Search API 密钥
TAVILY_API_KEY=tvly-dev-your-key-here

# ============================================================
# Mock 模式（开发/测试用，不消耗 API 配额）
# ============================================================

# 启用 Mock LLM 模式（不调用真实 LLM API）
# MOCK_LLM=true

# 启用 Mock 搜索模式（不调用 Tavily API）
# MOCK_SEARCH=true

# ============================================================
# 路径配置（可选）
# ============================================================

# 方法论文档路径（默认：./方法论-v2.md）
# METHODOLOGY_PATH=./方法论-v2.md

# 报告输出目录（默认：./reports）
# REPORTS_DIR=./reports

# Checkpoint 目录（默认：./checkpoints）
# CHECKPOINT_DIR=./checkpoints
